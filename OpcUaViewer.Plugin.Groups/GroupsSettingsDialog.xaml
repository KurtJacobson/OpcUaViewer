<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpcUaViewer.Plugin.Groups.GroupsSettingsDialog"
        Title="Groups Settings"
        WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="Height" Width="520"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterOwner"
        Foreground="#FFDCDCDC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OpcUaViewer.Theme;component/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource NavBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="Groups — Settings" VerticalAlignment="Center"
                       Margin="16,0" FontWeight="SemiBold"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20,16" >

            <Label Content="CAM Folder" Foreground="{StaticResource TextSubBrush}"/>
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CamFolderBox" Grid.Column="0" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse…" Tag="CamFolder" Click="Browse_Click" Padding="12,6"/>
            </Grid>

            <Label Content="CAM Output Path" Foreground="{StaticResource TextSubBrush}"/>
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CamOutputBox" Grid.Column="0" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse…" Tag="CamOutput" Click="Browse_Click" Padding="12,6"/>
            </Grid>

            <Label Content="CAM Products Path" Foreground="{StaticResource TextSubBrush}"/>
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CamProductsBox" Grid.Column="0" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse…" Tag="CamProducts" Click="Browse_Click" Padding="12,6"/>
            </Grid>

            <Label Content="Product Path Prefix" Foreground="{StaticResource TextSubBrush}"/>
            <TextBox x:Name="ProductPrefixBox" Margin="0,4,0,4"/>
            <TextBlock Text="Prefix prepended to product IDs when resolving CAM file paths."
                       Foreground="{StaticResource TextSubBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>

        </StackPanel>

        <!-- Button bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,6"/>
                <Button Content="Save" Click="Save_Click"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,6"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
