<UserControl x:Class="OpcUaViewer.Plugin.Groups.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="528" d:DesignWidth="930">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OpcUaViewer.Theme;component/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <Style x:Key="OrderListItemStyle" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding"     Value="0"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource GridLineBrush}"
                                Padding="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2E4A6A"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoFieldStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Foreground"        Value="{StaticResource TextBrush}"/>
            <Setter Property="FontFamily"        Value="Segoe UI"/>
            <Setter Property="FontSize"          Value="13"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="Padding"           Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="False">
                    <Setter Property="Background"      Value="{StaticResource InputBgBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsReadOnly" Value="False"/>
                        <Condition Property="IsFocused"  Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Background>
        <StaticResource ResourceKey="BgBrush"/>
    </UserControl.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Toolbar ═══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="⟳  Reload"        Command="{Binding ReloadCommand}"    Margin="0,0,8,0"/>
                <Button Content="⬆  Import CSV..." Command="{Binding ImportCsvCommand}" Background="#FF285020"/>
            </StackPanel>
        </Border>

        <!-- ══ Two-pane content ═══════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" MinWidth="160"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Orders list ────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{StaticResource NavBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10,8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Groups" Style="{StaticResource PanelHeaderStyle}" Margin="0"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Orders}"
                             SelectedItem="{Binding SelectedOrder}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource OrderListItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="itemBd" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock x:Name="orderIdTb"  Text="{Binding OrderId}"  FontWeight="SemiBold"/>
                                        <TextBlock x:Name="fileNameTb" Text="{Binding FileName}"
                                                   Foreground="{StaticResource TextSubBrush}" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Highlight}" Value="Active">
                                        <Setter TargetName="itemBd"     Property="Background" Value="#FF193519"/>
                                        <Setter TargetName="orderIdTb"  Property="Foreground" Value="#FFB0EFB0"/>
                                        <Setter TargetName="fileNameTb" Property="Foreground" Value="#FF80C080"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Highlight}" Value="Dim">
                                        <Setter TargetName="itemBd"     Property="Background" Value="Transparent"/>
                                        <Setter TargetName="orderIdTb"  Property="Foreground" Value="#FF484848"/>
                                        <Setter TargetName="fileNameTb" Property="Foreground" Value="#FF383838"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- New / Edit / Delete -->
                    <Border Grid.Row="2"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="8,6"
                            Visibility="{Binding ShowNormalButtons, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="New"    Command="{Binding NewGroupCommand}"    Margin="0,0,6,0"/>
                            <Button Content="Edit"   Command="{Binding EditGroupCommand}"   Margin="0,0,6,0"/>
                            <Button Content="Delete" Command="{Binding DeleteGroupCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- ── Right: Info panel + products grid ─────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Group info panel -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="File:"  VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding EditFileName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Style="{StaticResource InfoFieldStyle}" Margin="0,0,12,0"/>
                        <Label Grid.Row="0" Grid.Column="2" Content="Order:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding EditOrderId,  UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Style="{StaticResource InfoFieldStyle}" Grid.ColumnSpan="3"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Customer:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EditCustomer, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Style="{StaticResource InfoFieldStyle}" Margin="0,0,12,0"/>
                        <Label Grid.Row="1" Grid.Column="2" Content="Qty:"   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding EditQty,      UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Style="{StaticResource InfoFieldStyle}" Margin="0,0,8,0"/>
                        <Label Grid.Row="1" Grid.Column="4" Content="Prod:"  VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Row="1" Grid.Column="5" Text="{Binding EditCompleted,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Style="{StaticResource InfoFieldStyle}"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Info:"  VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EditInfoText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Style="{StaticResource InfoFieldStyle}" Grid.ColumnSpan="5"/>
                    </Grid>
                </Border>

                <!-- Products DataGrid -->
                <DataGrid Grid.Row="1"
                          x:Name="ProductGrid"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="List ID"  Binding="{Binding ListId}"      Width="105" IsReadOnly="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                        <DataGridTextColumn Header="Product"  Binding="{Binding DisplayName}" Width="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Material" Binding="{Binding MaterialId}"  Width="80"  IsReadOnly="True"/>
                        <DataGridTextColumn Header="Thk"      Binding="{Binding Thickness}"   Width="65"  IsReadOnly="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                        <DataGridTextColumn Header="Length"   Binding="{Binding Length}"      Width="80"  IsReadOnly="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                        <DataGridTextColumn Header="Width"    Binding="{Binding Width}"       Width="80"  IsReadOnly="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                        <DataGridTextColumn Header="Ord Qty"  Binding="{Binding OrdQty}"      Width="65"  IsReadOnly="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                        <DataGridTextColumn Header="Run Qty"  Binding="{Binding RunQty}"      Width="65"  IsReadOnly="False"/>
                        <DataGridTextColumn Header="Hint"     Binding="{Binding Hint}"        Width="*"   IsReadOnly="{Binding DataContext.IsViewMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF2E4A6A"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Highlight}" Value="Active">
                                    <Setter Property="Background" Value="#FF5A3700"/>
                                    <Setter Property="Foreground" Value="#FFFFD28C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Highlight}" Value="Dim">
                                    <Setter Property="Background" Value="#FF161616"/>
                                    <Setter Property="Foreground" Value="#FF404040"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>

                <!-- Products action bar -->
                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="10,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                    Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVis}}">
                            <Button Content="Add Products..."  Command="{Binding AddProductsCommand}"    Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="Remove Selected"  Command="{Binding RemoveProductsCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding ShowEditButtons, Converter={StaticResource BoolToVis}}">
                            <Button Content="✔  Save"   Command="{Binding SaveGroupCommand}"  Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,0"/>
                            <Button Content="✕  Cancel" Command="{Binding CancelEditCommand}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding ShowNormalButtons, Converter={StaticResource BoolToVis}}">
                            <Button Content="▶  Run Group"    Command="{Binding RunGroupCommand}"    Background="#FF285028" Margin="0,0,8,0"/>
                            <Button Content="✕  Cancel Group" Command="{Binding CancelGroupCommand}" Background="#FF602020"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
