<Window x:Class="OpcUaViewer.Plugin.Groups.CsvImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="778" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource TextSubBrush}"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SubHeadStyle" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="{StaticResource TextSubBrush}"/>
            <Setter Property="FontSize"          Value="10"/>
            <Setter Property="FontStyle"         Value="Italic"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Margin="18"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect Color="#FF000000" Direction="270"
                              ShadowDepth="6" BlurRadius="24" Opacity="0.75"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="60"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource NavBrush}"
                    CornerRadius="6,6,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <TextBlock Text="Import CSV"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{StaticResource TextBrush}"
                           FontWeight="SemiBold" FontSize="13"/>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,16,20,16">

                <!-- CSV file -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CSV File:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox   Grid.Column="1" x:Name="CsvPathBox" IsReadOnly="True" Margin="0,0,8,0"/>
                    <Button    Grid.Column="2" Content="Browse…" Width="90" Click="Browse_Click"/>
                </Grid>

                <!-- Column mapping header -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Column Mapping" Style="{StaticResource SectionLabelStyle}"/>
                    <TextBlock Grid.Column="1" Text="Column name"    Style="{StaticResource SubHeadStyle}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="2" Text="RegEx — optional capture group extracts a substring" Style="{StaticResource SubHeadStyle}"/>
                </Grid>

                <!-- Mapping rows -->
                <ItemsControl x:Name="MappingRows" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox   Grid.Column="1" Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" ToolTip="{Binding ColumnTip}"/>
                                <TextBox   Grid.Column="2" Text="{Binding Regex,  UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding RegexTip}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Group name -->
                <TextBlock Text="Group" Style="{StaticResource SectionLabelStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Name:" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox   Grid.Column="1" x:Name="GroupNameBox"/>
                </Grid>
            </StackPanel>

            <!-- Button bar -->
            <Border Grid.Row="2"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,6,6"
                    Padding="14,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel" Width="100" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Content="Import" Width="100" Style="{StaticResource AccentButtonStyle}" Click="Import_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
