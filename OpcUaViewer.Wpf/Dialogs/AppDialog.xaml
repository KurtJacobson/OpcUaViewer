<Window x:Class="OpcUaViewer.Wpf.Dialogs.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource NavBrush}"
                MouseLeftButtonDown="TitleBar_Drag">
            <TextBlock x:Name="TitleText"
                       VerticalAlignment="Center" Margin="14,0,0,0"
                       Foreground="{StaticResource TextBrush}"
                       FontWeight="SemiBold" FontSize="13"/>
        </Border>

        <!-- Message -->
        <Grid Grid.Row="1" Margin="20,18,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="IconText"
                       Grid.Column="0"
                       FontSize="26" Margin="0,1,14,0"
                       VerticalAlignment="Top"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock x:Name="MessageText"
                       Grid.Column="1"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="13" LineHeight="20"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Button bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button x:Name="YesButton" Content="Yes" Width="90" Margin="0,0,8,0"
                        Click="Yes_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="NoButton"  Content="No"  Width="90" Margin="0,0,0,0"
                        Click="No_Click"/>
                <Button x:Name="OkButton"  Content="OK"  Width="90" Margin="0,0,0,0"
                        Click="Ok_Click"  Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
