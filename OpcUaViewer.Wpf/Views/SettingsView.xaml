<UserControl x:Class="OpcUaViewer.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900"
             Background="{StaticResource BgBrush}">

    <UserControl.Resources>
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSubBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="20,8"/>
            <Setter Property="FontFamily"      Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize"        Value="{StaticResource FontSizeMd}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground"                   Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Tab strip ═════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="0,0,24,0"/>
                <TabControl x:Name="SettingsTabs"
                            Background="Transparent" BorderThickness="0"
                            TabStripPlacement="Top" Padding="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <StackPanel Orientation="Horizontal">
                                <TabPanel IsItemsHost="True"/>
                            </StackPanel>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="General" Style="{StaticResource SettingsTabItemStyle}"/>
                    <TabItem Header="Plugins" Style="{StaticResource SettingsTabItemStyle}"/>
                </TabControl>
            </StackPanel>
        </Border>

        <!-- ══ Content area ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- General -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding SelectedIndex, ElementName=SettingsTabs,
                                       Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                <StackPanel Margin="32,24" MaxWidth="640" HorizontalAlignment="Left" Width="497">

                    <TextBlock Text="OPC UA CONNECTION" Style="{StaticResource PanelHeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <!-- URL row -->
                            <Label Content="Endpoint URL"/>
                            <TextBox Text="{Binding MonitorTab.EndpointUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,4,0,12"/>

                            <!-- Status + connect row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextSubBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MonitorTab.IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <TextBlock Grid.Column="2" Text="{Binding MonitorTab.StatusText}"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource TextSubBrush}"
                                           TextTrimming="CharacterEllipsis"/>

                                <Button Grid.Column="4"
                                        Command="{Binding MonitorTab.ConnectCommand}"
                                        Padding="20,6">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                                            <Setter Property="Content" Value="Connect"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MonitorTab.IsBusy}" Value="True">
                                                    <Setter Property="Content"   Value="Connecting…"/>
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <Button Grid.Column="6"
                                        Content="Disconnect"
                                        Command="{Binding MonitorTab.DisconnectCommand}"
                                        Padding="20,6"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="UI OPTIONS" Style="{StaticResource PanelHeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="16" Margin="0,0,0,0">
                        <CheckBox Content="Enable on-screen keyboard" IsChecked="{Binding KeyboardEnabled}"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Plugins -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="32,24,32,0"
                          Visibility="{Binding SelectedIndex, ElementName=SettingsTabs,
                                       Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                <StackPanel MaxWidth="800" HorizontalAlignment="Left">

                    <TextBlock Text="INSTALLED PLUGINS" Style="{StaticResource PanelHeaderStyle}"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Changes take effect after restarting the application."
                               Foreground="{StaticResource TextSubBrush}"
                               FontSize="{StaticResource FontSizeSm}" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding PluginService.Plugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" CornerRadius="4"
                                        Padding="16,12" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"   Value="{StaticResource SurfaceBrush}"/>
                                            <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LoadError, Converter={StaticResource NullOrEmptyToBool}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}"/>
                                                    <Setter Property="Background"  Value="{StaticResource ErrorSurfaceBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Error badge -->
                                                <Border Background="{StaticResource ErrorBrush}"
                                                        CornerRadius="3" Padding="5,1" Margin="0,0,8,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LoadError, Converter={StaticResource NullOrEmptyToBool}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="LOAD FAILED" FontSize="10" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Normal info (hidden when failed) -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LoadError, Converter={StaticResource NullOrEmptyToBool}}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Description, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSubBrush}"
                                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Margin="0,4,0,0">
                                                    <Run Text="Tabs: "  Foreground="{StaticResource TextSubBrush}"/>
                                                    <Run Text="{Binding TabList, Mode=OneWay}" Foreground="{StaticResource TextSubBrush}"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding FilePath, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSubBrush}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Error detail (shown when failed) -->
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LoadError, Converter={StaticResource NullOrEmptyToBool}}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding LoadError, Mode=OneWay}"
                                                           Foreground="{StaticResource ErrorBrush}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding FilePath, Mode=OneWay}"
                                                           Foreground="{StaticResource TextSubBrush}"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Normal actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="16,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LoadError, Converter={StaticResource NullOrEmptyToBool}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Configure"
                                                    Command="{Binding ConfigureCommand}"
                                                    Margin="0,0,12,0"
                                                    Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVis}}"/>
                                            <CheckBox IsChecked="{Binding IsEnabled}" Content="Enabled"/>
                                        </StackPanel>

                                        <!-- Error actions -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center" Margin="16,0,0,0">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LoadError, Converter={StaticResource NullOrEmptyToBool}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Copy Error"
                                                    Tag="{Binding LoadError}"
                                                    Click="CopyError_Click"
                                                    Padding="12,6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource TextSubBrush}"
                               FontSize="{StaticResource FontSizeSm}"
                               Visibility="{Binding PluginService.Plugins.Count, Converter={StaticResource ZeroToVisibility}}">
                        No plugins found. Place plugin DLLs in the plugins folder next to the application,
                        or in %LocalAppData%\OpcUaViewer\plugins\.
                    </TextBlock>

                </StackPanel>
            </ScrollViewer>

        </Grid><!-- /content Grid -->

        <!-- ══ Shared save bar ═══════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="32,12">
            <Button Content="Save Settings"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Right"
                    Padding="28,10"/>
        </Border>

    </Grid>
</UserControl>
