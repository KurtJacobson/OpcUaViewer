<UserControl x:Class="OpcUaViewer.Wpf.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="⟳  Reload"
                        Command="{Binding ReloadCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="⬆  Import CSV..."
                        Command="{Binding ImportCsvCommand}"
                        Background="#FF325032"/>
                <Separator Width="1" Height="28" Background="{StaticResource BorderBrush}" Margin="12,0"/>
                <TextBlock Text="Product Groups" Style="{StaticResource PanelHeaderStyle}"
                           VerticalAlignment="Center" Margin="0"/>
            </StackPanel>
        </Border>

        <!-- Two-pane content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Orders list -->
            <Border Grid.Column="0" Background="{StaticResource NavBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="10,8"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="Groups" Style="{StaticResource PanelHeaderStyle}" Margin="0"/>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Orders}"
                             SelectedItem="{Binding SelectedOrder}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,6">
                                    <TextBlock Text="{Binding OrderId}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding CustomerName}"
                                               Foreground="{StaticResource TextSubBrush}"
                                               FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF2E4A6A"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectionBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Products grid -->
            <Grid Grid.Column="2" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="12,8"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding SelectedOrder.OrderId, FallbackValue='No group selected'}"
                               Style="{StaticResource PanelHeaderStyle}" Margin="0"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="List ID"   Binding="{Binding ListId}"      Width="100"/>
                        <DataGridTextColumn Header="Product"   Binding="{Binding DisplayName}" Width="160"/>
                        <DataGridTextColumn Header="Material"  Binding="{Binding MaterialId}"  Width="80"/>
                        <DataGridTextColumn Header="Thk"       Binding="{Binding Thickness}"   Width="65"/>
                        <DataGridTextColumn Header="Length"    Binding="{Binding Length}"      Width="80"/>
                        <DataGridTextColumn Header="Width"     Binding="{Binding Width}"       Width="80"/>
                        <DataGridTextColumn Header="Ord Qty"   Binding="{Binding OrdQty}"      Width="65"/>
                        <DataGridTextColumn Header="Run Qty"   Binding="{Binding RunQty}"      Width="65"/>
                        <DataGridTextColumn Header="Hint"      Binding="{Binding Hint}"        Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
