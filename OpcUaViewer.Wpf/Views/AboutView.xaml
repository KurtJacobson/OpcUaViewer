<UserControl x:Class="OpcUaViewer.Wpf.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24" MaxWidth="560" HorizontalAlignment="Left">

            <!-- App identity -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="AppNameText"
                           FontSize="22" FontWeight="Light"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="AppVersionText"
                           FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,3"
                           Foreground="{StaticResource TextSubBrush}"/>
            </StackPanel>
            <TextBlock Text="© MetalForming LLC"
                       Foreground="{StaticResource TextSubBrush}" FontSize="11"
                       Margin="0,0,0,24"/>

            <!-- License block -->
            <TextBlock Text="LICENSE" Style="{StaticResource PanelHeaderStyle}"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,8"/>

            <Border x:Name="LicenseBorder"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Licensee -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Licensed to"
                               Foreground="{StaticResource TextSubBrush}" FontSize="11"
                               Margin="0,0,0,10" VerticalAlignment="Top"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock x:Name="LicenseeText"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="AddressText"
                                   Foreground="{StaticResource TextSubBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Valid Until -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Valid until"
                               Foreground="{StaticResource TextSubBrush}" FontSize="11"
                               Margin="0,0,0,10" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="ValidUntilText"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="ValidBadge"
                                CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="ValidBadgeText" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Maintenance -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Maintenance until"
                               Foreground="{StaticResource TextSubBrush}" FontSize="11"
                               Margin="0,0,0,10" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="MaintenanceText"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Border x:Name="MaintBadge"
                                CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="MaintBadgeText" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Issued -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Issued"
                               Foreground="{StaticResource TextSubBrush}" FontSize="11"
                               Margin="0,0,0,10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="IssuedText" Grid.Row="3" Grid.Column="1"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>

                    <!-- Notes (conditional) -->
                    <TextBlock x:Name="NotesLabel" Grid.Row="4" Grid.Column="0" Text="Notes"
                               Foreground="{StaticResource TextSubBrush}" FontSize="11"
                               VerticalAlignment="Top" Visibility="Collapsed"/>
                    <TextBlock x:Name="NotesText" Grid.Row="4" Grid.Column="1"
                               Foreground="{StaticResource TextSubBrush}" FontSize="11"
                               TextWrapping="Wrap" Visibility="Collapsed"/>

                </Grid>
            </Border>

            <!-- Install license button (shown when no valid license) -->
            <Button x:Name="InstallLicenseButton"
                    Content="Install License…"
                    Margin="0,12,0,0" Padding="16,8"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="InstallLicense_Click"/>

            <!-- No license fallback -->
            <Border x:Name="NoLicenseBorder"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="20,14"
                    Visibility="Collapsed">
                <TextBlock Text="No valid license found. Place a license.lic file in the application folder."
                           Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
