<Window x:Class="OpcUaViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:OpcUaViewer.Wpf.Tabs"
        xmlns:views="clr-namespace:OpcUaViewer.Wpf.Views"
        Title="OPC UA Viewer"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="SingleBorderWindow"
        Height="700" Width="1200"
        MinHeight="500" MinWidth="800">

    <!-- DataTemplate registry: ViewModel type → View (plugin tabs registered via merged ResourceDictionaries) -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type tabs:MonitorTab}">
            <views:MonitorView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type tabs:SettingsTab}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Navigation panel ════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource NavBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App brand -->
                <Border Grid.Row="0"
                        Padding="10,18,10,18"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <TextBlock Text="OPC UA&#x0A;VIEWER"
                               TextAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="Bold"
                               LineHeight="18"/>
                </Border>

                <!-- Tab nav -->
                <ListBox x:Name="NavListBox"
                         Grid.Row="1"
                         ItemsSource="{Binding NavTabs}"
                         SelectedItem="{Binding SelectedTab, Mode=OneWay}"
                         SelectionChanged="NavTabs_SelectionChanged"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                         Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Margin="0,2,0,2">
                                <TextBlock Text="{Binding Icon}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Pinned-bottom tabs (e.g. Settings) + version -->
                <StackPanel Grid.Row="2">
                    <Separator Margin="12,0"/>
                    <ListBox x:Name="PinnedListBox"
                             ItemsSource="{Binding PinnedTabs}"
                             SelectedItem="{Binding SelectedTab, Mode=OneWay}"
                             SelectionChanged="PinnedTabs_SelectionChanged"
                             Style="{StaticResource NavListBoxStyle}"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                             Margin="0,4,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="VersionText"
                               Text="v0.0.0"
                               FontSize="10"
                               Foreground="{StaticResource TextSubBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Content area ════════════════════════════════════════════════ -->
        <ContentPresenter Grid.Column="1"
                          Content="{Binding SelectedTab}"/>
    </Grid>
</Window>
