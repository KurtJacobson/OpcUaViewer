<Window x:Class="OpcUaViewer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpcUaViewer.Wpf.ViewModels"
        Title="Fold Control"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStyle="SingleBorderWindow"
        Height="700" Width="1200"
        MinHeight="500" MinWidth="800">

    <Window.Resources>
        <!-- Sub-tab strip style -->
        <Style x:Key="SubTabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="Foreground"   Value="{StaticResource TextSubBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{Binding Title}"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="{StaticResource FontSizeMd}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground"  Value="{StaticResource TextBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Navigation panel ════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{StaticResource NavBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App brand -->
                <Border Grid.Row="0"
                        Padding="10,16,10,16"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="FOLD&#x0A;CONTROL"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   LineHeight="18"/>
                        <TextBlock x:Name="VersionText"
                                   Text="v0.0.0"
                                   FontSize="10"
                                   Foreground="{StaticResource TextSubBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Tab group nav -->
                <ListBox x:Name="NavListBox"
                         Grid.Row="1"
                         ItemsSource="{Binding NavGroups}"
                         SelectedItem="{Binding SelectedGroup, Mode=OneWay}"
                         SelectionChanged="NavGroups_SelectionChanged"
                         Style="{StaticResource NavListBoxStyle}"
                         ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                         Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabGroupViewModel}">
                            <StackPanel HorizontalAlignment="Center" Margin="0,2,0,2">
                                <TextBlock Text="{Binding Icon}"
                                           FontSize="20"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="11"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Pinned-bottom groups (e.g. Settings) + version -->
                <StackPanel Grid.Row="2">
                    <Separator Margin="12,0"/>
                    <ListBox x:Name="PinnedListBox"
                             ItemsSource="{Binding PinnedGroups}"
                             SelectedItem="{Binding SelectedGroup, Mode=OneWay}"
                             SelectionChanged="PinnedGroups_SelectionChanged"
                             Style="{StaticResource NavListBoxStyle}"
                             ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                             Margin="0,4,0,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabGroupViewModel}">
                                <StackPanel HorizontalAlignment="Center" Margin="0,2,0,2">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="20"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Content area ════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sub-tab strip — only visible when selected group has multiple tabs -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Visibility="{Binding SelectedGroup.HasMultipleTabs,
                                 Converter={StaticResource BoolToVis}}">
                <ListBox ItemsSource="{Binding SelectedGroup.Tabs}"
                         SelectedItem="{Binding SelectedGroup.SelectedTab}"
                         SelectionChanged="SubTabs_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource SubTabItemStyle}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <!-- Active view -->
            <ContentPresenter Grid.Row="1"
                              Content="{Binding SelectedGroup.SelectedView}"/>
        </Grid>
    </Grid>
</Window>
