<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpcUaViewer.Plugin.Webcam.WebcamSettingsDialog"
        Title="Webcam Settings"
        WindowStyle="None" ResizeMode="NoResize"
        SizeToContent="Height" Width="360"
        Background="#FF1E1E1E"
        WindowStartupLocation="CenterOwner"
        Foreground="#FFDCDCDC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OpcUaViewer.Theme;component/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Grid.Row="0" Background="{StaticResource NavBrush}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <TextBlock Text="Webcam — Settings" VerticalAlignment="Center"
                       Margin="16,0" FontWeight="SemiBold"/>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20,16">
            <Label Content="Camera Index" Foreground="{StaticResource TextSubBrush}"/>
            <ComboBox x:Name="CameraIndexBox" Margin="0,4,0,0" SelectedIndex="0">
                <ComboBoxItem Content="0 — Default camera"/>
                <ComboBoxItem Content="1"/>
                <ComboBoxItem Content="2"/>
                <ComboBoxItem Content="3"/>
            </ComboBox>
            <TextBlock Text="Select the camera device index. 0 is typically the built-in or first USB camera."
                       Foreground="{StaticResource TextSubBrush}"
                       FontSize="{StaticResource FontSizeSm}"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Button bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,6"/>
                <Button Content="Save" Click="Save_Click"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,6"/>
            </StackPanel>
        </Border>
    </Grid>
    </Border>
</Window>
