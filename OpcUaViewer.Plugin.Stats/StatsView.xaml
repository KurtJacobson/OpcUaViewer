<UserControl x:Class="OpcUaViewer.Plugin.Stats.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OpcUaViewer.Theme;component/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Badge: colored pill showing a machine mode -->
            <Style x:Key="ModeBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="12,4"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Opacity" Value="0.35"/>
            </Style>
            <Style x:Key="ModeBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Metric card -->
            <Style x:Key="MetricCard" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="MinWidth" Value="120"/>
            </Style>

            <!-- DataGrid rows: green highlight when active -->
            <Style x:Key="ActiveGridRow" TargetType="DataGridRow">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Background" Value="#22BB66"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Small reset button in card corner — inherits DarkButtonStyle template for proper hover -->
            <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource DarkButtonStyle}">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Padding" Value="5,1"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
            </Style>

            <!-- DataGrid column header style -->
            <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="8,0"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource BgBrush}">

        <!-- ── Header row: mode badges + live timers ───────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel>
                <!-- Live timers on the right -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LiveSetup}"
                               Foreground="{StaticResource TextSubBrush}"
                               FontSize="12" Margin="0,0,20,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding LivePart}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mode badges -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#337799">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ModeBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAuto}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="AUTO" Style="{StaticResource ModeBadgeText}"/>
                    </Border>

                    <Border Background="#557733">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ModeBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="MANUAL" Style="{StaticResource ModeBadgeText}"/>
                    </Border>

                    <Border Background="#886633">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ModeBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSetup}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="SETUP" Style="{StaticResource ModeBadgeText}"/>
                    </Border>

                    <Border Background="#226644">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ModeBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBending}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="BENDING" Style="{StaticResource ModeBadgeText}"/>
                    </Border>

                    <Border Background="#993333">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ModeBadge}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOperatorWait}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="OPERATOR WAIT" Style="{StaticResource ModeBadgeText}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Metric cards row ────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource BgBrush}"
                Padding="16,12,8,12">
            <StackPanel Orientation="Horizontal">

                <!-- Total Hours -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource AccentBrush}" Height="3" CornerRadius="2" Margin="-16,-12,-16,8"/>
                        <StackPanel Grid.Row="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="↺" Style="{StaticResource ResetButton}"
                                        Command="{Binding ResetHoursCommand}" VerticalAlignment="Top"/>
                                <TextBlock Text="TOTAL HOURS" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TotalHours}" FontSize="22" FontWeight="Light"
                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Producing Hours -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#337799" Height="3" CornerRadius="2" Margin="-16,-12,-16,8"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="PRODUCING HOURS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSubBrush}"/>
                            <TextBlock Text="{Binding ProducingHours}" FontSize="22" FontWeight="Light"
                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Efficiency -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#557733" Height="3" CornerRadius="2" Margin="-16,-12,-16,8"/>
                        <StackPanel Grid.Row="1">
                            <TextBlock Text="EFFICIENCY" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSubBrush}"/>
                            <TextBlock Text="{Binding Efficiency}" FontSize="22" FontWeight="Light"
                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Total Parts -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#886633" Height="3" CornerRadius="2" Margin="-16,-12,-16,8"/>
                        <StackPanel Grid.Row="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="↺" Style="{StaticResource ResetButton}"
                                        Command="{Binding ResetPartsCommand}" VerticalAlignment="Top"/>
                                <TextBlock Text="TOTAL PARTS" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TotalParts}" FontSize="22" FontWeight="Light"
                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Total Bends -->
                <Border Style="{StaticResource MetricCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#226644" Height="3" CornerRadius="2" Margin="-16,-12,-16,8"/>
                        <StackPanel Grid.Row="1">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="↺" Style="{StaticResource ResetButton}"
                                        Command="{Binding ResetBendsCommand}" VerticalAlignment="Top"/>
                                <TextBlock Text="TOTAL BENDS" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSubBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TotalBends}" FontSize="22" FontWeight="Light"
                                       Foreground="{StaticResource TextBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </Border>

        <!-- ── Per-product DataGrid ────────────────────────────────────────── -->
        <DataGrid ItemsSource="{Binding Parts}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowStyle="{StaticResource ActiveGridRow}"
                  Background="{StaticResource BgBrush}"
                  RowBackground="{StaticResource SurfaceBrush}"
                  AlternatingRowBackground="{StaticResource Surface2Brush}"
                  ColumnHeaderStyle="{StaticResource GridHeader}"
                  BorderThickness="0"
                  ColumnHeaderHeight="28"
                  RowHeight="26"
                  Margin="0">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Part"       Binding="{Binding Part}"      Width="*"   MinWidth="120"/>
                <DataGridTextColumn Header="Count"      Binding="{Binding Count}"     Width="60"  MinWidth="50"/>
                <DataGridTextColumn Header="Last Cycle" Binding="{Binding LastCycle}" Width="90"  MinWidth="70"/>
                <DataGridTextColumn Header="Avg Cycle"  Binding="{Binding AvgCycle}"  Width="90"  MinWidth="70"/>
                <DataGridTextColumn Header="Min Cycle"  Binding="{Binding MinCycle}"  Width="90"  MinWidth="70"/>
                <DataGridTextColumn Header="Max Cycle"  Binding="{Binding MaxCycle}"  Width="90"  MinWidth="70"/>
                <DataGridTextColumn Header="Last Setup" Binding="{Binding LastSetup}" Width="90"  MinWidth="70"/>
                <DataGridTextColumn Header="Avg Setup"  Binding="{Binding AvgSetup}"  Width="90"  MinWidth="70"/>
                <DataGridTextColumn Header="Avg Bend"   Binding="{Binding AvgBend}"   Width="90"  MinWidth="70"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>
