<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpcUaViewer.Core\OpcUaViewer.Core.csproj"/>
    <ProjectReference Include="..\OpcUaViewer.Theme\OpcUaViewer.Theme.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude from XAML compilation, then embed as a raw resource for runtime loading -->
    <Page Remove="ExampleResources.xaml"/>
    <EmbeddedResource Include="ExampleResources.xaml"/>
  </ItemGroup>
</Project>
